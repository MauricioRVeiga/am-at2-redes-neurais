@base = http://127.0.0.1:8000

### 1. Metadados do serviço
GET {{base}}/diagnostico/modelo
User-Agent: Tester-Audit-Agent
Accept: application/json

### 2. Predição - cliente novo, contrato mensal, fibra e boleto eletrônico (perfil de risco)
POST {{base}}/predict
User-Agent: Tester-Audit-Agent
Content-Type: application/json

{
  "gender": "Female",
  "SeniorCitizen": 1,
  "Partner": "No",
  "Dependents": "No",
  "tenure": 2,
  "PhoneService": "Yes",
  "MultipleLines": "No",
  "InternetService": "Fiber optic",
  "OnlineSecurity": "No",
  "OnlineBackup": "No",
  "DeviceProtection": "No",
  "TechSupport": "No",
  "StreamingTV": "Yes",
  "StreamingMovies": "Yes",
  "Contract": "Month-to-month",
  "PaperlessBilling": "Yes",
  "PaymentMethod": "Electronic check",
  "MonthlyCharges": 99.65,
  "TotalCharges": 199.3
}

